# .gitignore for CollegeBot
# =========================
# Never commit secrets, virtual environments, or generated artefacts.

# Secrets and environment
.env
.streamlit/secrets.toml

# Python virtual environments (NEVER commit these)
venv/
env/
.venv/
collegebot_env/

# Generated artefacts (large; push separately or regenerate)
dataset/
*.jsonl

# Note: faiss_store/ should be committed for Streamlit Cloud deployment
# If your FAISS index is very large (>100MB), consider using Git LFS
# or regenerating it on deployment. For now, it's NOT gitignored.

# Model checkpoints (very large; never commit)
*_checkpoints/
*_merged/
*.bin
*.safetensors
*.gguf

# Evaluation outputs ARE committed on purpose.
# A metric nobody can reproduce or audit is not evidence.  evaluation/
# eval_results.json records the corpus path, retrieval config, judge model and
# per-question outcomes alongside the scores, so a reader can check the claim
# instead of taking it on trust.

# Tooling caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
