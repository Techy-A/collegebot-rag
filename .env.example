# .env.example  --  Environment variable template for CollegeBot
# ===============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
# "The lock on the door is only as strong as the secret behind it."
#     -- Security engineering principle

# Required: Groq Cloud free API key
# Register at https://console.groq.com (no credit card)
GROQ_API_KEY=

# Required if using fine-tuned models from HF Hub
# Generate at https://huggingface.co/settings/tokens (Write permission)
HF_TOKEN=

# Hugging Face model IDs for fine-tuned models
# Replace "your-username" with your actual HF username
PHI3_MODEL_ID=/collegebot-phi3-mini
MISTRAL_MODEL_ID=/collegebot-mistral-7b

# Optional: HF Inference Endpoint URLs (for cloud deployment without GPU)
# Leave blank to use local 4-bit loading (requires CUDA) or Groq fallback
PHI3_ENDPOINT_URL=
MISTRAL_ENDPOINT_URL=

# Paths (change only if you moved the default directories)
CHROMA_PATH=./chroma_db
DATA_DIR=./data
